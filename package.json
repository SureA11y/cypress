{
  "name": "@surea11y/cypress",
  "version": "1.1.0",
  "description": "Cypress binding for surea11y -- scan real, live-rendered pages for accessibility issues.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "accessibility-testing",
    "cypress",
    "e2e",
    "e2e-testing",
    "audit",
    "aria",
    "surea11y"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/cypress.git"
  },
  "homepage": "https://github.com/SureA11y/cypress#readme",
  "bugs": {
    "url": "https://github.com/SureA11y/cypress/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@surea11y/binding-base": "^1.1.0",
    "@surea11y/core": "^1.5.0"
  },
  "peerDependencies": {
    "cypress": ">=13.0.0"
  },
  "devDependencies": {
    "@cypress/webpack-batteries-included-preprocessor": "^4.2.0",
    "cypress": "^15.21.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && cypress run --spec \"tests/**/*.cy.js\"",
    "test:unit": "node --test tests/*.test.js",
    "test:cypress": "cypress run --spec \"tests/**/*.cy.js\"",
    "cypress:open": "cypress open",
    "example": "cypress run --spec \"examples/basic-scan.cy.js\"",
    "example:e2e": "cypress run --spec \"examples/e2e-test-example.cy.js\""
  }
}
