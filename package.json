{
  "name": "@surea11y/cypress",
  "version": "1.4.1",
  "description": "Accessibility (a11y, WCAG) checks for Cypress tests: scan the live page with new A11yCoreBuilder().analyze() and get only proven violations, with findings that need human review listed separately.",
  "keywords": [
    "accessibility",
    "a11y",
    "a11y-testing",
    "wcag",
    "wcag21",
    "wcag22",
    "en301549",
    "en-301-549",
    "european-accessibility-act",
    "accessibility-testing",
    "cypress",
    "cypress-plugin",
    "e2e",
    "e2e-testing",
    "end-to-end",
    "audit",
    "aria",
    "surea11y"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/cypress.git"
  },
  "homepage": "https://github.com/SureA11y/cypress#readme",
  "bugs": {
    "url": "https://github.com/SureA11y/cypress/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "plugin.js",
    "plugin.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@surea11y/binding-base": "^1.5.0"
  },
  "peerDependencies": {
    "@surea11y/core": "^1.12.0",
    "cypress": ">=13.0.0"
  },
  "devDependencies": {
    "@surea11y/core": "^1.12.0",
    "@cypress/webpack-batteries-included-preprocessor": "^5.0.0",
    "cypress": "^15.21.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && cypress run --spec \"tests/**/*.cy.js\"",
    "test:unit": "node --test tests/*.test.js",
    "test:cypress": "cypress run --spec \"tests/**/*.cy.js\"",
    "cypress:open": "cypress open",
    "example": "cypress run --spec \"examples/basic-scan.cy.js\"",
    "example:e2e": "cypress run --spec \"examples/e2e-test-example.cy.js\"",
    "example:pack": "cypress run --spec \"examples/scan-with-pack.cy.js\""
  }
}
