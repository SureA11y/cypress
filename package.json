{
  "name": "@a11y-core/cypress",
  "version": "0.1.0",
  "description": "Cypress binding for a11y-core -- scan real, live-rendered pages for accessibility issues.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumoroso/a11y-core-cypress.git"
  },
  "homepage": "https://github.com/rumoroso/a11y-core-cypress#readme",
  "bugs": {
    "url": "https://github.com/rumoroso/a11y-core-cypress/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@a11y-core/binding-base": "^0.1.0",
    "@a11y-core/core": "^1.1.0"
  },
  "peerDependencies": {
    "cypress": ">=13.0.0"
  },
  "devDependencies": {
    "@cypress/webpack-batteries-included-preprocessor": "^4.2.0",
    "cypress": "^14.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" && cypress run --spec \"tests/**/*.cy.js\"",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:cypress": "cypress run --spec \"tests/**/*.cy.js\"",
    "cypress:open": "cypress open",
    "example": "cypress run --spec \"examples/basic-scan.cy.js\"",
    "example:e2e": "cypress run --spec \"examples/e2e-test-example.cy.js\""
  }
}
