{
  "name": "@surea11y/cypress",
  "version": "0.1.1",
  "description": "Cypress binding for surea11y -- scan real, live-rendered pages for accessibility issues.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumoroso/surea11y-core-cypress.git"
  },
  "homepage": "https://github.com/rumoroso/surea11y-core-cypress#readme",
  "bugs": {
    "url": "https://github.com/rumoroso/surea11y-core-cypress/issues"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@surea11y/binding-base": "^0.1.0",
    "@surea11y/core": "^1.1.0"
  },
  "peerDependencies": {
    "cypress": ">=13.0.0"
  },
  "devDependencies": {
    "@cypress/webpack-batteries-included-preprocessor": "^4.2.0",
    "cypress": "^14.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" && cypress run --spec \"tests/**/*.cy.js\"",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:cypress": "cypress run --spec \"tests/**/*.cy.js\"",
    "cypress:open": "cypress open",
    "example": "cypress run --spec \"examples/basic-scan.cy.js\"",
    "example:e2e": "cypress run --spec \"examples/e2e-test-example.cy.js\""
  }
}
